%%{init: {'theme': 'base', 'themeVariables': {'primaryColor': '#7B5E4A', 'primaryTextColor': '#fff', 'primaryBorderColor': '#3B2A20', 'lineColor': '#A67C52', 'secondaryColor': '#F2E7D5', 'tertiaryColor': '#FAF7F0', 'fontSize': '12px'}}}%%

graph TB
    %% ═══════════════════════════════════════════
    %% CLIENT LAYER
    %% ═══════════════════════════════════════════
    subgraph CLIENT["CLIENT LAYER — React 19 + TypeScript + Vite 8 + Tailwind v4"]
        direction TB

        subgraph AUTH_PAGES["Auth Flow"]
            LP[LandingPage]
            LI[LoginPage<br/>Email + Google OAuth]
            RG[RegisterPage]
            OB[OnboardingPage<br/>3-Step: Biometrics → Diet → Budget]
        end

        subgraph APP_PAGES["Protected App Pages (16 routes)"]
            DASH[DashboardPage<br/>Macro rings · AI input · Meals table · Streak]
            TRACK[TrackerPage<br/>4 meal slots · Quick add · Edit/Delete]
            FLOG[FoodLogPage<br/>Search · Custom food · Portion slider]
            FANA[FoodAnalyzePage<br/>Camera → Gemini Vision → DB match]
            PLAN[PlannerPage<br/>Day selector · Swap modal · Totals bar]
            CHAT[ChatPage<br/>SSE streaming · Language selector · Voice · TTS]
            SAFE[SafetyAuditorPage<br/>Allergens · Drugs · Conditions · Audit test]
            SYMP[SymptomLogPage<br/>Food reactions · Severity · Escalation]
            PROG[ProgressPage<br/>Weight chart · Weekly energy · Measurements]
            TWIN[NutriTwinPage<br/>What-If sim · NutriRescue · Deficiencies]
            GROC[GroceryPage<br/>Smart list · Pantry tracker · Fridge-to-Meal]
            INTL[AIIntelligencePage<br/>Meal analysis · Glossary]
            PROF[ClinicalProfilePage<br/>ICMR targets · Diet prefs · Cuisines]
            SETT[SettingsPage<br/>Profile edit · Dark mode · ICMR card · Logout]
            NUTR[NutritionistPage<br/>Client roster · Plan approval · Reports]
            AUDT[AuditTrailPage<br/>Safety verdicts · Filters · CSV export]
        end

        subgraph HOOKS["Custom Hooks"]
            H1[useAuth — Supabase session]
            H2[useProfile — Profile + targets + localStorage cache]
            H3[useFoodLog — Today's logs · CRUD]
            H4[useFood — Search · Common · Frequent foods]
            H5[useChat — SSE stream · Conversation memory]
            H6[useMealPlan — Generate · Swap · Rescue]
            H7[useClinicalSafety — Allergens · Drugs · Symptoms · Audit]
            H8[useDashboard — Aggregated daily nutrition]
            H9[useStreak — Consecutive logging days]
        end

        subgraph UI_LIB["Shared Components"]
            U1[AppShell — Sidebar + Header + MobileNav]
            U2[FoodSearch — Autocomplete + Custom food]
            U3[ChatInput — Text + Voice + Language]
            U4[ChatMessage — Markdown + TTS + Citations]
            U5[ErrorBoundary · Skeleton · Button · Card · Input]
            U6[SearchCommandDialog — ⌘K global search]
            U7[ThemeContext — Light / Dark / System]
        end

        subgraph FE_LIB["Libraries"]
            L1[lib/supabase.ts — Supabase client]
            L2[lib/api.ts — apiGet/apiPost with auth headers]
            L3[lib/nutrition.ts — BMR · TDEE · calculateFoodNutrition]
            L4[types/database.ts — 15+ TypeScript interfaces]
        end
    end

    %% ═══════════════════════════════════════════
    %% API GATEWAY
    %% ═══════════════════════════════════════════
    subgraph GATEWAY["API GATEWAY — FastAPI + Pydantic"]
        direction TB
        MW[Supabase Auth Middleware<br/>JWT → /auth/v1/user verification]

        subgraph ROUTES["REST API Routes (9 modules)"]
            R1[GET /api/health]
            R2[GET/POST /api/food — search · log · analyze]
            R3[POST /api/meals — plan · swap · rescue]
            R4[POST /api/chat — message · stream SSE · analyze]
            R5[GET/POST /api/users — profile · targets]
            R6[POST /api/feedback]
            R7[GET/POST /api/grocery — generate · lists]
            R8[GET/POST /api/analytics — weekly · what-if]
            R9[GET/POST /api/nutritionist — clients · approve]
        end
    end

    %% ═══════════════════════════════════════════
    %% INTELLIGENCE LAYER
    %% ═══════════════════════════════════════════
    subgraph INTEL["INTELLIGENCE LAYER — Multi-Agent Orchestrator"]
        direction TB

        ORC[Orchestrator<br/>Intent Classifier: rag │ personal │ action │ general<br/>Language extraction · Safety pre-check]

        subgraph AGENT_POOL["7 Specialized Agents"]
            A1["📚 Knowledge Agent<br/>RAG retrieval → context building → cited response"]
            A2["🍽️ Meal Plan Agent<br/>Profile + targets + consumed → JSON meal plan<br/>Budget · diet · region constrained"]
            A3["🔄 Swap Agent<br/>Protein parity scoring · diet compatibility<br/>Top 3 alternatives with explanations"]
            A4["🆘 Rescue Agent<br/>Deviation detection → remaining targets<br/>→ compensating dinner suggestion"]
            A5["🛒 Grocery Agent<br/>Plan items → aggregated shopping list<br/>Grouped by aisle · cost estimated"]
            A6["📊 Feedback Agent<br/>Classify: taste│time│budget│health<br/>Auto-adjust preferences"]
            A7["📷 Vision Agent<br/>Image → Gemini → food identification<br/>→ DB match → IFCT nutrition"]
        end
    end

    %% ═══════════════════════════════════════════
    %% SERVICES LAYER
    %% ═══════════════════════════════════════════
    subgraph SERVICES["SERVICES LAYER"]
        direction TB

        subgraph NUTRITION["Deterministic Nutrition Engine"]
            NE1["calculate_bmr(weight, height, age, gender)<br/>Mifflin-St Jeor: 10W + 6.25H - 5A ± gender"]
            NE2["calculate_tdee(bmr, activity_level)<br/>Multipliers: 1.2 │ 1.375 │ 1.55 │ 1.725 │ 1.9"]
            NE3["calculate_macro_targets(tdee, weight)<br/>Protein: 1g/kg · Fat: 25% · Carbs: remainder"]
            NE4["calculate_food_nutrition(nv, quantity_g)<br/>value = nv_per_100g × quantity / 100"]
        end

        subgraph SAFETY["Clinical Safety Engine"]
            SF1["Allergen Detection<br/>Direct match + hidden allergens<br/>(naan→dairy, gulab jamun→milk solids)"]
            SF2["Cross-Reactivity<br/>peanut→legumes, shellfish→dust mites<br/>wheat→barley, dairy→goat milk"]
            SF3["Drug-Nutrient Interactions<br/>23 interactions: Warfarin+VitK, Metformin+alcohol<br/>Statins+grapefruit, Levothyroxine+soy/calcium"]
            SF4["Medical Conditions<br/>Diabetes+GI foods, Hypertension+sodium<br/>CKD+potassium, Gout+purines, Cholesterol+fat"]
        end

        subgraph FOOD_SVC["Food Service"]
            FS1["search_food(query) — name + tamil + hindi + synonyms"]
            FS2["get_common_foods() — is_common=true"]
            FS3["get_seasonal_foods(season)"]
            FS4["log_food_entry(user, date, meal, food, qty)"]
        end

        subgraph RAG["RAG Pipeline"]
            RAG1["seed_knowledge.py<br/>25 ICMR/WHO articles → chunks → embeddings"]
            RAG2["retriever.py<br/>Query → embed → pgvector cosine similarity<br/>Top 5 chunks above 0.3 threshold"]
            RAG3["context_builder.py<br/>Evidence + user profile + conversation → prompt"]
        end
    end

    %% ═══════════════════════════════════════════
    %% AI PROVIDERS
    %% ═══════════════════════════════════════════
    subgraph AI_LAYER["AI PROVIDERS"]
        direction LR
        subgraph GROQ["Groq Cloud"]
            G1["Qwen 3.8 27B<br/>Primary LLM<br/>generate() · generate_stream() · json_mode<br/>28 RPM rate limit"]
        end
        subgraph GOOGLE["Google AI Studio"]
            G2["Gemini Flash<br/>Fallback LLM + Vision<br/>generate() · vision()"]
            G3["gemini-embedding-001<br/>768-dim embeddings<br/>embed() · embed_query()"]
        end
        RL["Rate Limiter<br/>Per-provider request tracking<br/>Auto-failover: Groq → Google"]
    end

    %% ═══════════════════════════════════════════
    %% DATA LAYER
    %% ═══════════════════════════════════════════
    subgraph DATA["DATA LAYER — Supabase (PostgreSQL + pgvector + Auth + RLS)"]
        direction TB

        subgraph TABLES["17+ Tables with Row Level Security"]
            T1["user_profiles — name, age, gender, height, weight, diet, region, budget"]
            T2["user_nutrition_targets — calories, protein, carbs, fat, fibre, iron, calcium, B12"]
            T3["food_items — 200+ items, name_tamil, name_hindi, category, is_veg, cost, portion"]
            T4["nutritional_values — per 100g: calories, protein, carbs, fat, fibre, iron, calcium, B12, VitC, potassium"]
            T5["food_logs + food_log_items — daily meal logging with quantities"]
            T6["meal_plans + meal_plan_items — AI-generated plans with explanations"]
            T7["conversations + chat_messages — chat history with citations"]
            T8["clinical_profiles — allergies, medications, conditions, clinician, consent"]
            T9["symptom_logs — food reactions with severity and timing"]
            T10["audit_logs — safety verdicts for every food entry"]
            T11["pantry_items — ingredient tracking with expiry"]
            T12["grocery_lists + grocery_items — shopping lists from plans"]
            T13["document_chunks — RAG embeddings (768-dim pgvector)"]
            T14["food_synonyms — Tamil/Hindi/English aliases for search"]
            T15["allergen_cross_reactions — 15 cross-reactivity entries"]
            T16["food_allergen_map — 30+ hidden allergen mappings"]
            T17["drug_nutrient_interactions — 23 drug-food interactions"]
            T18["seasonal_foods — 30 seasonal availability entries"]
            T19["progress_measurements — weight, waist, body fat, energy"]
        end

        subgraph DB_FEATURES["Database Features"]
            DB1["pgvector — cosine similarity for RAG retrieval"]
            DB2["pg_trgm — fuzzy text search on food names"]
            DB3["daily_nutrition_summary — precomputed view"]
            DB4["Row Level Security — every table policy-protected"]
            DB5["Supabase Auth — Email + Google OAuth + JWT"]
        end
    end

    %% ═══════════════════════════════════════════
    %% CONNECTIONS
    %% ═══════════════════════════════════════════

    CLIENT -->|"HTTPS · Vite Proxy /api → :8000"| GATEWAY
    CLIENT -->|"Supabase JS SDK (direct)"| DATA

    MW --> ROUTES
    ROUTES --> ORC
    ORC --> AGENT_POOL
    AGENT_POOL --> NUTRITION & SAFETY & FOOD_SVC & RAG
    AGENT_POOL --> AI_LAYER
    RAG --> AI_LAYER
    NUTRITION & SAFETY & FOOD_SVC --> DATA
    RAG --> DATA
    AI_LAYER -.->|"Rate-limited<br/>auto-failover"| RL

